<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_off"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <FrameLayout
        android:id="@+id/widget_power_container"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_control_background">
        <ImageView
            android:id="@+id/widget_power"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_power" />
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/widget_node_flag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_node"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
            <Chronometer
                android:id="@+id/widget_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/widget_ip_flag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_exit_ip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CFFFFFFF"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/widget_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textColor="#BFFFFFFF"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
