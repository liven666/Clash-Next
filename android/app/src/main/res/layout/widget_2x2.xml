<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_off"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="9dp">

    <FrameLayout
        android:id="@+id/widget_power_container"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_control_background">

        <ImageView
            android:id="@+id/widget_power"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_power" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_status_off"
        android:textColor="#D9FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_tap_to_toggle"
        android:visibility="gone" />
</LinearLayout>
